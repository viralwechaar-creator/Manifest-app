{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build -w web",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/migrations/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|uploads/|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ],
  "regions": [
    "bom1"
  ]
}
