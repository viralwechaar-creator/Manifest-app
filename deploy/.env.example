# Copy this file to ".env" in the project folder and fill in every value. Never share or commit ".env".
# The website address without https:// (point its DNS "A" record at this server first)
DOMAIN=school.example.org
# A long random password for the database:   openssl rand -hex 24
DB_PASSWORD=
# 64 hex characters (protects two-step-verification secrets):   openssl rand -hex 32
# Keep a copy somewhere safe. If it is lost, staff must set up two-step verification again.
APP_SECRET=
