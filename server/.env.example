NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://school:school_dev_pw@localhost:5432/school
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=replace-with-64-hex-chars
# Public address of the website (used for the CSRF origin check)
PUBLIC_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
STORAGE_DIR=./storage
# Set true when served over HTTPS (always true in production)
COOKIE_SECURE=false
# Sign-in attempts allowed per IP address per 15 minutes
LOGIN_RATE_LIMIT=30
# API requests allowed per IP address per minute
API_RATE_LIMIT=300
# Email / SMS / WhatsApp copies of notifications. 'off' keeps everything in the app. See docs/NOTIFICATIONS.md
NOTIFY_PROVIDER=off
# NOTIFY_WEBHOOK_URL=https://your-relay.example.org/send
# NOTIFY_WEBHOOK_SECRET=at-least-16-random-characters
# Trial sites only: lets a Super Admin load fictional demo data into an empty school
# ALLOW_DEMO_DATA=true
